{
  "manifest_version": 3,
  "name": "Subtitle Translator",
  "version": "3.0",
  "description": "Translates HTML5 video subtitles in real-time with multi-language & multi-engine support. Works on YouTube and most sites.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subtitle Translator Settings"
  },
  "host_permissions": [
    "<all_urls>",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*",
    "https://lingva.pussthecat.org/*",
    "https://translate.plausibility.cloud/*"
  ],
  "content_scripts": [
    {
      "matches": [
          "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
          "https://www.youtube.com/*",
          "https://youtube.com/*"
      ],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
